      "id": "node-jsearch-004",
      "name": "Search Jobs - JSearch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst jobs = data.data || [];\n\nif (jobs.length === 0) {\n  return [{ json: { error: 'No jobs found from JSearch API. Check your API key and query.' } }];\n}\n\nreturn jobs.slice(0, 10).map(job => ({\n  json: {\n    jobId: job.job_id || String(Date.now() + Math.random()),\n    jobTitle: job.job_title || 'Unknown Title',\n    company: job.employer_name || 'Unknown Company',\n    location: [job.job_city, job.job_state, job.job_country].filter(Boolean).join(', ') || 'Remote',\n    salary: job.job_min_salary\n      ? (job.job_salary_currency || 'USD') + ' ' + job.job_min_salary + '-' + job.job_max_salary + '/yr'\n      : 'Not specified',\n    jobUrl: job.job_apply_link || job.job_google_link || '',\n    source: job.job_publisher || 'JSearch',\n    requirements: (job.job_highlights && job.job_highlights.Qualifications\n      ? job.job_highlights.Qualifications.slice(0, 5).join(' | ')\n      : 'Not specified'),\n    description: (job.job_description || '').substring(0, 600),\n    datePosted: job.job_posted_at_datetime_utc || new Date().toISOString(),\n    companyDomain: (job.employer_website || '')\n      .replace(/https?:\\/\\/(www\\.)?/, '')\n      .split('/')[0] || ''\n  }\n}));"
      },
      "id": "node-parse-005",
      "name": "Parse Job Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-split-006",
      "name": "Split Jobs Batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [780, 300]
    },
